{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": ["config:recommended", "helpers:pinGitHubActionDigests"],
  "ignorePaths": [".dagger/sdk/**", ".dagger/clients/**", "dagger/*/sdk/**", "dagger/*/clients/**"],
  "lockFileMaintenance": {
    "description": "Re-resolve the lockfiles weekly so transitive deps stay current. The pep621 rule below only bumps packages declared in the workspace member pyproject.toml files; lock-only deps pulled in through extras (requests via google-auth[requests], certifi, charset-normalizer) are invisible to that manager and otherwise sit at whatever version was resolved the last time something forced a full resolve.",
    "enabled": true,
    "schedule": ["before 4am on monday"]
  },
  "customManagers": [
    {
      "customType": "regex",
      "description": "Update the uv version required by local commands and CI.",
      "managerFilePatterns": ["/^pyproject\\.toml$/"],
      "matchStrings": [
        "# renovate: datasource=github-releases depName=astral-sh/uv\\nrequired-version = \">=(?<currentValue>[^\"]+)\""
      ],
      "depNameTemplate": "astral-sh/uv",
      "datasourceTemplate": "github-releases",
      "extractVersionTemplate": "^v?(?<version>.+)$"
    },
    {
      "customType": "regex",
      "description": "Propose reviewed Amazon Linux ARM64 AMI replacements instead of resolving latest at deploy time",
      "managerFilePatterns": ["/^infrastructure/ec2\\.tf$/"],
      "matchStrings": [
        "# amiFilter=(?<packageName>[^\\n]+)\\n\\s*# currentImageName=(?<currentDigest>[^\\n]+)\\n\\s*al2023_arm64_ami_id\\s*=\\s*\"(?<currentValue>ami-[0-9a-f]{17})\""
      ],
      "depNameTemplate": "amazon-linux-2023-arm64",
      "datasourceTemplate": "aws-machine-image",
      "versioningTemplate": "aws-machine-image"
    },
    {
      "customType": "regex",
      "description": "Update annotated versions and optional digests from the declared datasource",
      "managerFilePatterns": ["/^\\.github/workflows/.+\\.ya?ml$/"],
      "matchStrings": [
        "# renovate: datasource=(?<datasource>\\S+) depName=(?<depName>\\S+?)(?: versioning=(?<versioning>\\S+))?\\n\\s+\\w+:\\s+(?<currentValue>\\S+)(?:\\n\\s+\\w+:\\s+(?<currentDigest>\\S+))?"
      ]
    },
    {
      "customType": "regex",
      "description": "Keep actionlint's version and its pinned download-script commit in lockstep with upstream GitHub release tags",
      "managerFilePatterns": ["/^\\.github/workflows/.+\\.ya?ml$/"],
      "matchStrings": [
        "ACTIONLINT_VERSION:\\s*(?<currentValue>\\S+)[\\s\\S]*?raw\\.githubusercontent\\.com/rhysd/actionlint/(?<currentDigest>[0-9a-f]{40})/"
      ],
      "depNameTemplate": "rhysd/actionlint",
      "datasourceTemplate": "github-tags",
      "extractVersionTemplate": "^v?(?<version>.+)$"
    },
    {
      "customType": "regex",
      "description": "Update the pinned Dagger beta CLI and engine.",
      "managerFilePatterns": [
        "/^\\.dagger-version$/"
      ],
      "matchStrings": [
        "(?<currentValue>v1\\.0\\.0-beta\\.[0-9]+)"
      ],
      "depNameTemplate": "dagger/dagger",
      "datasourceTemplate": "github-tags"
    },
    {
      "customType": "regex",
      "description": "Update the Python SDK; regenerate clients when reviewing its PR.",
      "managerFilePatterns": [
        "/^dagger\\.toml$/"
      ],
      "matchStrings": [
        "source = \"github.com/dagger/python-sdk@(?<currentValue>[^\"\\s]+)\""
      ],
      "depNameTemplate": "dagger/python-sdk",
      "datasourceTemplate": "github-tags"
    },
    {
      "customType": "regex",
      "description": "Keep the pinned datadog-static-analyzer release in the CI workflow in lockstep with upstream GitHub release tags",
      "managerFilePatterns": ["/^\\.github/workflows/.+\\.ya?ml$/"],
      "matchStrings": ["DDSA_VERSION:\\s*(?<currentValue>\\S+)"],
      "depNameTemplate": "DataDog/datadog-static-analyzer",
      "datasourceTemplate": "github-releases",
      "extractVersionTemplate": "^v?(?<version>.+)$"
    },
    {
      "customType": "regex",
      "description": "Update the Socket module release.",
      "managerFilePatterns": [
        "/^dagger/socket-firewall/src/socket_firewall/__init__\\.py$/"
      ],
      "matchStrings": [
        "VERSION = \"(?<currentValue>v[^\"]+)\""
      ],
      "depNameTemplate": "SocketDev/sfw-free",
      "datasourceTemplate": "github-releases"
    },
    {
      "customType": "regex",
      "description": "Update Socket x86_64 checksums from release metadata.",
      "managerFilePatterns": [
        "/^dagger/socket-firewall/src/socket_firewall/checksums\\.sha256$/"
      ],
      "matchStrings": [
        "# version=(?<currentValue>\\S+) asset=sfw-free-linux-x86_64\\n(?<currentDigest>[0-9a-f]{64})"
      ],
      "depNameTemplate": "SocketDev/sfw-free",
      "datasourceTemplate": "custom.socket-linux-x86_64"
    },
    {
      "customType": "regex",
      "description": "Update Socket arm64 checksums from release metadata.",
      "managerFilePatterns": [
        "/^dagger/socket-firewall/src/socket_firewall/checksums\\.sha256$/"
      ],
      "matchStrings": [
        "# version=(?<currentValue>\\S+) asset=sfw-free-linux-arm64\\n(?<currentDigest>[0-9a-f]{64})"
      ],
      "depNameTemplate": "SocketDev/sfw-free",
      "datasourceTemplate": "custom.socket-linux-arm64"
    }
  ],
  "customDatasources": {
    "socket-linux-x86_64": {
      "defaultRegistryUrlTemplate": "https://api.github.com/repos/SocketDev/sfw-free/releases?per_page=100",
      "format": "json",
      "transformTemplates": [
        "{\"releases\": $map($[tag_name and assets[name = \"sfw-free-linux-x86_64\"].digest], function($release) { {\"version\": $release.tag_name, \"releaseTimestamp\": $release.published_at, \"digest\": $substringAfter($release.assets[name = \"sfw-free-linux-x86_64\"][0].digest, \":\")} }), \"sourceUrl\": \"https://github.com/SocketDev/sfw-free\"}"
      ]
    },
    "socket-linux-arm64": {
      "defaultRegistryUrlTemplate": "https://api.github.com/repos/SocketDev/sfw-free/releases?per_page=100",
      "format": "json",
      "transformTemplates": [
        "{\"releases\": $map($[tag_name and assets[name = \"sfw-free-linux-arm64\"].digest], function($release) { {\"version\": $release.tag_name, \"releaseTimestamp\": $release.published_at, \"digest\": $substringAfter($release.assets[name = \"sfw-free-linux-arm64\"][0].digest, \":\")} }), \"sourceUrl\": \"https://github.com/SocketDev/sfw-free\"}"
      ]
    },
    "opengrep-releases": {
      "defaultRegistryUrlTemplate": "https://api.github.com/repos/opengrep/opengrep/releases?per_page=100",
      "format": "json",
      "transformTemplates": [
        "{\"releases\": $map($[tag_name and assets[name = \"opengrep_manylinux_x86\"].digest], function($release) { {\"version\": $release.tag_name, \"releaseTimestamp\": $release.published_at, \"changelogUrl\": $release.html_url, \"digest\": $release.assets[name = \"opengrep_manylinux_x86\"][0].digest} }), \"sourceUrl\": \"https://github.com/opengrep/opengrep\"}"
      ]
    }
  },
  "packageRules": [
    {
      "description": "Review tested Dagger beta engine upgrades explicitly.",
      "matchPackageNames": [
        "dagger/dagger"
      ],
      "ignoreUnstable": false,
      // One hour is the deliberate build-tool release window, matching uv below.
      // nosemgrep: package_managers.renovate.renovate-missing-minimum-release-age.renovate-missing-minimum-release-age
      "minimumReleaseAge": "1 hour",
      "automerge": false
    },
    {
      "description": "Keep the Socket module and verified artifact checksums on one release.",
      "matchPackageNames": [
        "SocketDev/sfw-free"
      ],
      "groupName": "Socket Firewall",
      // Apply the same one-hour tool release window to Socket's binaries and digests.
      // nosemgrep: package_managers.renovate.renovate-missing-minimum-release-age.renovate-missing-minimum-release-age
      "minimumReleaseAge": "1 hour",
      "automerge": false
    },
    {
      "description": "Match Renovate's npm manager (used for this pnpm workspace) to pnpm's eight-hour quarantine so direct dependency PRs are not opened before pnpm will accept them.",
      "matchManagers": ["npm"],
      // This repo deliberately uses an eight-hour quarantine; the generic rule's seven-day default is not our policy.
      // nosemgrep: package_managers.renovate.renovate-missing-minimum-release-age.renovate-missing-minimum-release-age
      "minimumReleaseAge": "8 hours",
      // Update the manifest floor as well as the lockfile. pnpm's strict age policy
      // rejects the `pnpm update --no-save` path used for in-range lockfile updates.
      "rangeStrategy": "bump"
    },
    // Both pins select the standalone pnpm binary; review them on the same release.
    // nosemgrep: package_managers.renovate.renovate-missing-minimum-release-age.renovate-missing-minimum-release-age
    {
      "description": "Keep pnpm's packageManager pin and Docker build stage on the same version.",
      "matchPackageNames": ["pnpm", "ghcr.io/pnpm/pnpm"],
      "matchUpdateTypes": ["major", "minor", "patch"],
      "minimumGroupSize": 2,
      "groupName": "pnpm"
    },
    // This rule only groups the uv binary and container updates; the following rule applies the one-hour age gate.
    // nosemgrep: package_managers.renovate.renovate-missing-minimum-release-age.renovate-missing-minimum-release-age
    {
      "description": "Keep the minimum uv version tested in CI on the same release as the Docker builder.",
      "matchPackageNames": ["astral-sh/uv", "ghcr.io/astral-sh/uv"],
      "matchUpdateTypes": ["major", "minor", "patch"],
      // Require both files in the group; the GitHub release's cooldown gates the GHCR image.
      "minimumGroupSize": 2,
      "groupName": "uv"
    },
    {
      "description": "Apply the uv release cooldown using the timestamped GitHub release.",
      "matchPackageNames": ["astral-sh/uv"],
      "matchUpdateTypes": ["major", "minor", "patch"],
      // One hour is the deliberate uv release cooldown for this project.
      // GHCR has no Renovate release timestamp, so it inherits the grouped release's age gate.
      // nosemgrep: package_managers.renovate.renovate-missing-minimum-release-age.renovate-missing-minimum-release-age
      "minimumReleaseAge": "1 hour"
    },
    {
      "description": "Review AMI updates explicitly because applying them replaces the app instance.",
      "matchDatasources": ["aws-machine-image"],
      "automerge": false
    },
    // This rule only groups the two Chainguard image updates; it does not control package release timing.
    // nosemgrep: package_managers.renovate.renovate-missing-minimum-release-age.renovate-missing-minimum-release-age
    {
      "description": "Update the Chainguard Python builder and runtime images together.",
      "matchDatasources": ["docker"],
      "matchPackageNames": ["cgr.dev/chainguard/python"],
      "matchCurrentValue": "/^latest(-dev)?$/",
      "groupName": "Chainguard Python"
    },
    {
      "description": "Bump the >= floors in the workspace member pyproject.toml files, which also regenerates the root uv.lock. The default rangeStrategy only edits a manifest when the new version escapes the declared range, and an open-ended '>=x' is satisfied by every release — so without this the backend gets no update PRs at all.",
      "matchManagers": ["pep621"],
      // Match tool.uv.exclude-newer in the root pyproject.toml.
      // nosemgrep: package_managers.renovate.renovate-missing-minimum-release-age.renovate-missing-minimum-release-age
      "minimumReleaseAge": "1 hour",
      "rangeStrategy": "bump"
    },
    {
      "description": "Manage Python minor upgrades manually across pyproject.toml, .python-version, Dockerfile, and the matching Chainguard runtime. Disable Renovate updates to requires-python so the pep621 bump strategy does not introduce patch-level minimum versions.",      "matchManagers": ["pep621"],
      "matchDepNames": ["python"],
      "enabled": false
    },
    {
      "description": "Let pnpm and uv enforce their own release-age policies during lockfile maintenance, which has no individual release timestamp.",
      "matchManagers": ["npm", "pep621"],
      "matchUpdateTypes": ["lockFileMaintenance"],
      "minimumReleaseAge": null
    },
    // This compatibility cap is reviewed by CI; immediate compatible releases are allowed.
    // nosemgrep: package_managers.renovate.renovate-missing-minimum-release-age.renovate-missing-minimum-release-age
    {
      "description": "Hold eslint at 9. The plugins eslint-config-next bundles (eslint-plugin-react, -jsx-a11y, -import) all cap their peer eslint at ^9, so eslint 10 installs only because npm downgrades the nested peer conflict to a warning. Drop this rule once those plugins declare eslint 10 support.",
      "matchPackageNames": ["eslint"],
      "allowedVersions": "<10"
    },
    // Coupled AI SDK updates are reviewed and tested together without an age delay.
    // nosemgrep: package_managers.renovate.renovate-missing-minimum-release-age.renovate-missing-minimum-release-age
    {
      "description": "Keep the AI SDK React bindings and core package on compatible releases.",
      "matchPackageNames": ["@ai-sdk/react", "ai"],
      "groupName": "AI SDK"
    }
  ]
}
