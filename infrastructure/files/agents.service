[Unit]
Description=Kitchen Agent
After=docker.service network-online.target
Requires=docker.service
Wants=network-online.target

[Service]
Type=simple
Restart=on-failure
RestartSec=5s
ExecStartPre=-/usr/bin/docker stop agents
ExecStartPre=-/usr/bin/docker rm agents
ExecStartPre=/bin/sh -c '/usr/bin/aws ecr get-login-password --region ${aws_region} | /usr/bin/docker login --username AWS --password-stdin ${ecr_registry}'
# Secrets are fetched at start and written to a 0600 file rather than passed as -e, so
# they never appear in `docker inspect` or this unit (which lands in EC2 user data).
ExecStartPre=/bin/bash -c 'set -e; set -o pipefail; umask 077 && { \
    printf "ANTHROPIC_API_KEY=%s\n" "$(/usr/bin/aws ssm get-parameter --name ${ssm_parameter_name} --with-decryption --query Parameter.Value --output text --region ${aws_region})"; \
    printf "GOOGLE_CLIENT_SECRET=%s\n" "$(/usr/bin/aws ssm get-parameter --name ${client_secret_parameter_name} --with-decryption --query Parameter.Value --output text --region ${aws_region})"; \
    printf "SESSION_SECRET=%s\n" "$(/usr/bin/aws ssm get-parameter --name ${session_secret_parameter_name} --with-decryption --query Parameter.Value --output text --region ${aws_region})"; \
} > /run/agents.env'
ExecStartPre=/usr/bin/docker pull ${ecr_image}
ExecStart=/usr/bin/docker run \
    --name agents \
    --rm \
    --env-file /run/agents.env \
    -e GOOGLE_CLIENT_ID=${google_client_id} \
    -e APP_BASE_URL=${app_base_url} \
    -e ALLOWED_EMAILS=${allowed_emails} \
    -p 8080:8080 \
    -v /opt/agents/data:/app/data \
    ${ecr_image}
ExecStop=-/usr/bin/docker stop agents

[Install]
WantedBy=multi-user.target
