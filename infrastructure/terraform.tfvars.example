app_version          = "0.1.0@sha256:xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx"
anthropic_api_key    = "sk-ant-api03-xxxxxxxx"
google_client_id     = "xxxxxxxxxxxx-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx.apps.googleusercontent.com"
google_client_secret = "GOCSPX-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx"
tailscale_auth_key   = "tskey-auth-xxxxxxxxxxxxxx-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx"
tailscale_tailnet    = "tailxxxxxx.ts.net"

# The only thing restricting who can use the app. Google does not enforce its OAuth
# test-user list for apps requesting just openid/email/profile, so without this every
# Google account could complete sign-in.
allowed_emails = ["you@example.com"]

# Machine callers, which sign in with a bearer ID token instead of a browser. Optional:
# leave it out and the API is reachable only by a signed-in person.
# allowed_service_accounts = ["batch@your-project.iam.gserviceaccount.com"]

# The Aurora PostgreSQL cluster holding the pantry. Every one of these has a default, so
# the block is optional — shown here because the capacity floor is the one setting with a
# real cost/latency trade-off behind it.
#
# db_min_capacity = 0     # 0 pauses the cluster when idle (cheap, ~15s to resume)
# db_max_capacity = 4
# db_seconds_until_auto_pause = 3600
# db_engine_version = "17.4"
