# The build context is the repository root — see backend/Dockerfile.

.git/
.github/
.claude/
.agents/
.zed/
infrastructure/
scripts/
README.md

# Python. These need `**/` to reach backend/: a bare `.venv/` would only match one at
# the context root, and backend/.venv would be copied over the venv uv builds in the
# image — with macOS binaries, when the build is from a Mac.
**/.venv/
**/__pycache__/
**/*.py[co]
**/.pytest_cache/
backend/.python-version
backend/test_*.py
backend/conftest.py
# Built inside the image by the frontend stage; a local `just build` copy would only
# be overwritten.
backend/static/

# Node
frontend/node_modules/
frontend/.next/
frontend/out/
frontend/coverage/

# Secrets
**/.env
**/.env.*
